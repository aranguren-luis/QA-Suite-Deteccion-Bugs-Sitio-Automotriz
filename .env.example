# Configuración de la suite de automatización
# Copiar a .env y completar con los valores propios: cp .env.example .env

# === Requerida ===
# URL del ambiente de QA/demo bajo prueba (sin datos reales de clientes detrás).
BASE_URL=https://demo.example.com

# === Opcional — solo para los 3 specs que hacen contraste contra producción ===
# (bug-14-seo-localhost-3000, bug-19-cotizador-datos-mock-consultar, bug-20-redes-sociales-footer-sin-cuenta-oficial)
# Si no se define, esos 3 tests de contraste lanzan un error explícito en vez de apuntar a un dominio real por defecto.
PROD_URL=
